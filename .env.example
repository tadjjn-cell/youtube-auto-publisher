# Groq API (free at console.groq.com) — same key you already use for the Pinterest agent works fine
GROQ_API_KEY=

# Telegram (free at my.telegram.org) — run setup/get_telegram_session.py once to get TELEGRAM_SESSION
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_SOURCE_CHAT=me

# YouTube (Google Cloud Console, free) — run setup/get_youtube_token.py once to get these
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
